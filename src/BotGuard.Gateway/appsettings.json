{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379",
    "Seq": "http://seq:5341"
  },
  "ReverseProxy": {
    "Routes": {
      "all-traffic-route": {
        "ClusterId": "target-website-cluster",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "target-website-cluster": {
        "Destinations": {
          "target-site": {
            "Address": "http://localhost:8080/"
          }
        }
      }
    }
  }
}