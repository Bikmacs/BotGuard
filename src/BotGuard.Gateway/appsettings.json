{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "all-traffic-route": {
        "ClusterId": "target-website-cluster",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "target-website-cluster": {
        "Destinations": {
          "target-site": {
            "Address": "https://example.com/"
          }
        }
      }
    }
  }
}